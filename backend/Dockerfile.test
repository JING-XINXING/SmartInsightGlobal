FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt requirements-test.txt ./

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY . .

# 创建测试目录
RUN mkdir -p /app/test-results /app/coverage

# 设置Python路径
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1

# 默认命令：运行测试
CMD ["pytest", "tests/", "-v", "--cov=app", "--cov-report=xml:./test-results/coverage.xml", "--cov-report=html:./test-results/html", "--junitxml=./test-results/junit.xml"]